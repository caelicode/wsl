{
  "name": "caelicode-wsl",
  "version": "0.0.0-semantically-released",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/caelicode/wsl.git"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "semantic-release": "25.0.8"
  },
  "release": {
    "branches": ["main"],
    "tagFormat": "v${version}",
    "plugins": [
      ["@semantic-release/commit-analyzer", {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "deps", "release": "patch" }
        ]
      }],
      ["@semantic-release/release-notes-generator", {
        "preset": "conventionalcommits"
      }],
      ["@semantic-release/exec", {
        "prepareCmd": "bash .github/scripts/prepare-release-assets.sh ${nextRelease.version}"
      }],
      ["@semantic-release/github", {
        "draftRelease": true,
        "successComment": false,
        "failTitle": false,
        "releasedLabels": false,
        "assets": [
          { "path": "dist/caelicode-wsl-*.tar.gz" },
          { "path": "dist/*.sha256" },
          { "path": "dist/checksums.txt" },
          { "path": "dist/sbom.json" },
          { "path": "dist/caelicode-manifest.json" },
          { "path": "dist/caelicode-update-payload.tar.gz" }
        ]
      }]
    ]
  }
}
