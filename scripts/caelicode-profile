#!/usr/bin/env bash
# CaeliCode WSL — team profile layers
#
# Layers extra tool manifests on top of the built-in profile without
# forking the repo. Layers live in /etc/caelicode/profiles.d/*.toml
# (only a [tools] table of  name = "version"  pins is allowed) and are
# merged over the base profile in filename order — later layers win.
# caelicode-update re-applies layers automatically on every update.
#
# Usage:
#   caelicode-profile list                     # base + layers + tool counts
#   caelicode-profile add <name> <url|file>    # fetch/validate/install a layer
#   caelicode-profile remove <name>
#   caelicode-profile sync                     # merge + mise install + relink
#   caelicode-profile merge [--base <toml>]    # rebuild merged mise config only

set -euo pipefail

LAYERS_DIR="/etc/caelicode/profiles.d"
MISE_CONFIG="/opt/mise/config/config.toml"
BASE_DIR="/opt/caelicode"
CURRENT_LINK="${BASE_DIR}/current"
PROFILE="$(cat "${BASE_DIR}/PROFILE" 2>/dev/null || echo base)"

log() { echo "[caelicode-profile] $*"; }
err() { echo "[caelicode-profile] ERROR: $*" >&2; }

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi
run_priv() { if [ -z "$SUDO" ]; then "$@"; else sudo -n "$@"; fi; }

require_sudo() {
    if [ -n "$SUDO" ] && ! sudo -n true 2>/dev/null; then
        err "This command needs passwordless sudo or a root shell."
        exit 1
    fi
}

base_profile_toml() {
    local candidate
    for candidate in "${CURRENT_LINK}/profiles/${PROFILE}.toml" "${BASE_DIR}/profiles/${PROFILE}.toml"; do
        if [ -f "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
    done
    return 1
}

# validate_layer <file> — enforce "[tools] with string pins only" and
# print the tool list. Rejects anything else a fetched TOML might try
# to smuggle in.
validate_layer() {
    python3 - "$1" <<'PY'
import sys, tomllib

path = sys.argv[1]
try:
    with open(path, "rb") as f:
        data = tomllib.load(f)
except Exception as exc:
    print(f"invalid TOML: {exc}", file=sys.stderr)
    raise SystemExit(1)

extra = set(data) - {"tools"}
if extra:
    print(f"only a [tools] table is allowed (found: {', '.join(sorted(extra))})", file=sys.stderr)
    raise SystemExit(1)
tools = data.get("tools", {})
if not isinstance(tools, dict) or not tools:
    print("layer has no [tools] entries", file=sys.stderr)
    raise SystemExit(1)
for name, version in tools.items():
    if not isinstance(version, str):
        print(f"tool '{name}': version must be a string", file=sys.stderr)
        raise SystemExit(1)
    print(f"  {name} = {version}")
PY
}

do_merge() {
    local base_toml="${1:-}"
    if [ -z "$base_toml" ]; then
        base_toml="$(base_profile_toml)" || { err "base profile TOML not found for '${PROFILE}'"; exit 1; }
    fi
    local merged
    merged="$(python3 - "$base_toml" "$LAYERS_DIR" <<'PY'
import glob, os, sys, tomllib

base, layers_dir = sys.argv[1], sys.argv[2]

def load(path):
    with open(path, "rb") as f:
        return tomllib.load(f).get("tools", {})

tools = dict(load(base))
for layer in sorted(glob.glob(os.path.join(layers_dir, "*.toml"))):
    for name, version in load(layer).items():
        if isinstance(version, str):
            tools[name] = version

print("# Generated by caelicode-profile merge — do not edit.")
print(f"# Base: {base}")
print("[tools]")
for name, version in tools.items():
    print(f'"{name}" = "{version}"')
PY
)"
    printf '%s\n' "$merged" | run_priv tee "$MISE_CONFIG" >/dev/null
    log "Merged config written to ${MISE_CONFIG}"
}

run_mise() {
    run_priv env MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/opt/mise/config \
        XDG_DATA_HOME=/opt/mise PATH="/opt/mise/bin:/usr/local/bin:/usr/bin:/bin" \
        mise "$@"
}

regen_tool_symlinks() {
    local shim tool real
    for shim in /opt/mise/shims/*; do
        [ -e "$shim" ] || continue
        tool="$(basename "$shim")"
        real="$(run_mise which "$tool" 2>/dev/null || true)"
        if [ -n "$real" ] && [ -x "$real" ]; then
            run_priv ln -sf "$real" "/opt/mise/bin/${tool}"
        fi
    done
}

cmd_list() {
    echo ""
    echo "Base profile: ${PROFILE}"
    echo ""
    if compgen -G "${LAYERS_DIR}/*.toml" >/dev/null 2>&1; then
        echo "Layers (merged in this order, later wins):"
        local layer
        for layer in "${LAYERS_DIR}"/*.toml; do
            echo "  ● $(basename "$layer" .toml)"
            validate_layer "$layer" 2>/dev/null || echo "    (invalid layer — fix or remove)"
        done
    else
        echo "No layers installed. Add one:"
        echo "  caelicode-profile add team-tools https://example.com/team-tools.toml"
    fi
    echo ""
}

cmd_add() {
    local name="${1:-}" source="${2:-}" yes="${3:-}"
    if [ -z "$name" ] || [ -z "$source" ]; then
        err "usage: caelicode-profile add <name> <url|file> [--yes]"
        exit 2
    fi
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { err "layer name must be lowercase alphanumeric/hyphen"; exit 2; }
    require_sudo

    local tmp
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT

    case "$source" in
        https://*)
            log "Fetching ${source}..."
            curl -sfL --max-filesize 1048576 -o "$tmp" "$source" || { err "download failed"; exit 1; }
            ;;
        http://*)
            err "refusing plain-http layer sources — use https"
            exit 1
            ;;
        *)
            [ -f "$source" ] || { err "file not found: ${source}"; exit 1; }
            cp "$source" "$tmp"
            ;;
    esac

    log "Layer '${name}' provides:"
    validate_layer "$tmp" || exit 1

    if [ "$yes" != "--yes" ]; then
        if [ -t 0 ]; then
            read -r -p "Install this layer and sync tools? [y/N] " answer
            [[ "$answer" =~ ^[Yy] ]] || { log "Aborted."; exit 1; }
        else
            err "non-interactive session — re-run with --yes to confirm"
            exit 1
        fi
    fi

    run_priv mkdir -p "$LAYERS_DIR"
    run_priv cp "$tmp" "${LAYERS_DIR}/${name}.toml"
    run_priv chmod 644 "${LAYERS_DIR}/${name}.toml"
    log "Layer installed: ${LAYERS_DIR}/${name}.toml"
    cmd_sync
}

cmd_remove() {
    local name="${1:-}"
    [ -n "$name" ] || { err "usage: caelicode-profile remove <name>"; exit 2; }
    [ -f "${LAYERS_DIR}/${name}.toml" ] || { err "no such layer: ${name}"; exit 1; }
    require_sudo
    run_priv rm -f "${LAYERS_DIR}/${name}.toml"
    log "Layer removed: ${name}"
    cmd_sync
}

cmd_sync() {
    require_sudo
    do_merge
    log "Installing tools via mise (this can take a few minutes)..."
    if run_mise install 2>&1 | tail -20; then
        run_mise reshim || true
        regen_tool_symlinks
        log "✓ Tools synced. Restart your shell or run: exec \$SHELL"
    else
        err "mise install failed — check the output above, then re-run: caelicode-profile sync"
        exit 1
    fi
}

case "${1:-list}" in
    list|-l|--list) cmd_list ;;
    add)            cmd_add "${2:-}" "${3:-}" "${4:-}" ;;
    remove|rm)      cmd_remove "${2:-}" ;;
    sync)           cmd_sync ;;
    merge)
        # Internal hook (used by caelicode-update): rebuild the merged
        # mise config without installing. --base points at the NEW
        # release's profile TOML during an update.
        require_sudo
        if [ "${2:-}" = "--base" ] && [ -n "${3:-}" ]; then
            do_merge "$3"
        else
            do_merge
        fi
        ;;
    -h|--help)
        sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        ;;
    *)
        err "unknown command: $1 (try --help)"
        exit 2
        ;;
esac
