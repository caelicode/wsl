#!/usr/bin/env bash
# CaeliCode WSL — In-place updater
#
# Staged, checksum-verified updates from GitHub releases without
# reimporting the WSL distro. Releases are staged under
# /opt/caelicode/releases/<version> and activated by flipping the
# /opt/caelicode/current symlink, so a failed update never leaves a
# half-applied system and --rollback is a symlink flip away.
# User home directories and personal settings are never touched.
#
# Usage:
#   caelicode-update                  # Update to latest release
#   caelicode-update --check          # Check only (exit 0 up-to-date,
#                                     #   10 update available, 20 update
#                                     #   requires re-import, 1 error)
#   caelicode-update --dry-run        # Show what would change
#   caelicode-update --version        # Show installed version/profile
#   caelicode-update --version vX.Y.Z # Update (or pin back) to a tag
#   caelicode-update --rollback       # Return to the previous release
#   caelicode-update --full           # Full re-import guide (major upgrades)
#
# NOTE: The entire script is wrapped in main() so bash reads the whole
# file into memory before executing. Combined with the staged layout
# (the running copy lives in the previous release dir until pruning),
# this makes self-update safe.

main() {

set -euo pipefail

REPO="caelicode/wsl"
API_BASE="https://api.github.com/repos/${REPO}"
BASE_DIR="/opt/caelicode"
RELEASES_DIR="${BASE_DIR}/releases"
CURRENT_LINK="${BASE_DIR}/current"
ETC_DIR="/etc/caelicode"
SKEL_DIR="/etc/skel"
MISE_CONFIG="/opt/mise/config/config.toml"
VERSION_FILE="${BASE_DIR}/VERSION"
PROFILE_FILE="${BASE_DIR}/PROFILE"
PREVIOUS_FILE="${BASE_DIR}/PREVIOUS"
STATE_DIR="/var/lib/caelicode"
STATE_FILE="${STATE_DIR}/update-state.json"
ETAG_FILE="${STATE_DIR}/release-check.etag"
RELEASE_CACHE="${STATE_DIR}/release-latest.json"
MANIFEST_ASSET="caelicode-manifest.json"
PAYLOAD_ASSET="caelicode-update-payload.tar.gz"

TEMP_DIR="$(mktemp -d)"
# shellcheck disable=SC2064
trap "rm -rf $TEMP_DIR" EXIT

QUIET=false
log()  { $QUIET || echo "[caelicode-update] $*"; }
err()  { echo "[caelicode-update] ERROR: $*" >&2; }
warn() { echo "[caelicode-update] WARNING: $*" >&2; }

# Root shells run commands directly; everyone else needs passwordless sudo.
if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

require_sudo() {
    if [ -n "$SUDO" ] && ! sudo -n true 2>/dev/null; then
        err "This step needs sudo without a password prompt."
        err "Run inside an interactive shell (sudo caelicode-update), or restore"
        err "the default NOPASSWD rule in /etc/sudoers.d/caelicode."
        exit 1
    fi
}

# ── Parse Arguments ──────────────────────────────────────────────────
MODE="update"           # update | check | dry-run | show-version | rollback | full
TARGET_VERSION=""       # explicit tag for --version <tag>
FORCE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)     MODE="check"; shift ;;
        --dry-run)   MODE="dry-run"; shift ;;
        --rollback)  MODE="rollback"; shift ;;
        --full)      MODE="full"; shift ;;
        --force)     FORCE=true; shift ;;
        --quiet|-q)  QUIET=true; shift ;;
        --version)
            shift
            if [[ $# -gt 0 && "$1" != -* ]]; then
                TARGET_VERSION="$1"; shift
            else
                MODE="show-version"
            fi
            ;;
        -h|--help)
            cat <<'HELP'
Usage: caelicode-update [OPTIONS]

Staged, checksum-verified updates of CaeliCode WSL scripts, configs,
and tool versions from GitHub releases. Your home directory is never
modified.

Options:
  (none)             Update to the latest release
  --check            Check for updates without applying. Exit codes:
                       0  up to date
                       10 update available (in-place)
                       20 update available (requires full re-import)
                       1  check failed
  --dry-run          Show what would change without applying
  --version          Show the installed version and profile
  --version <tag>    Update (or pin back) to a specific release tag
  --rollback         Switch back to the previously installed release
  --full             Show the guide for a full distro re-import
  --force            Apply in-place even when the release is marked
                     as requiring a re-import
  --quiet, -q        Suppress informational output (used by the
                     scheduled update check)
  -h, --help         Show this help message

What gets updated:
  • /opt/caelicode/releases/<ver>/   Staged release (scripts, profiles, themes)
  • /opt/caelicode/current           Symlink flip — the atomic activation step
  • /etc/caelicode/starship.toml     Only if you have not customized it
  • /etc/skel/                       Shell templates for new users
  • mise tools                       Reinstalled to the new pinned versions,
                                     with /opt/mise/bin symlinks regenerated

What is NOT touched:
  • Your home directory (~/) and personal dotfiles
  • /etc/caelicode/config.yaml
  • apt packages (those need a full re-import — see --full)
HELP
            exit 0
            ;;
        *)
            err "Unknown option: $1"
            exit 1
            ;;
    esac
done

# ── Version / Profile Info ───────────────────────────────────────────
CURRENT_VERSION="$(cat "$VERSION_FILE" 2>/dev/null || echo "unknown")"
CURRENT_PROFILE="$(cat "$PROFILE_FILE" 2>/dev/null || echo "unknown")"

if [ "$MODE" = "show-version" ]; then
    echo "CaeliCode WSL ${CURRENT_VERSION}"
    echo "Profile: ${CURRENT_PROFILE}"
    if [ -f "$PREVIOUS_FILE" ]; then
        echo "Rollback available to: $(cat "$PREVIOUS_FILE")"
    fi
    exit 0
fi

# ── Full Upgrade Guide ───────────────────────────────────────────────
if [ "$MODE" = "full" ]; then
    DISTRO_NAME="caelicode-${CURRENT_PROFILE}"
    cat <<EOF

╔═══════════════════════════════════════════════════════════════╗
║  CaeliCode WSL — Full Distro Upgrade                          ║
╚═══════════════════════════════════════════════════════════════╝

Use this when a release includes new system packages, OS-level
changes, or breaking updates that can't be applied in-place.

Step 1 — Back up (from PowerShell, recommended):
  irm https://raw.githubusercontent.com/${REPO}/main/tools/caelicode-backup.ps1 | iex
  # or manually:  wsl --export ${DISTRO_NAME} C:\\caelicode-backup\\${DISTRO_NAME}.tar

Step 2 — Back up your home directory (from inside WSL):
  mkdir -p /mnt/c/caelicode-backup
  cp -a "\$HOME" /mnt/c/caelicode-backup/home-backup

Step 3 — Re-install (from PowerShell, as Administrator):
  wsl --shutdown
  wsl --unregister ${DISTRO_NAME}
  irm https://raw.githubusercontent.com/${REPO}/main/install.ps1 | iex

Step 4 — Restore your data (from inside the new WSL):
  cp -a /mnt/c/caelicode-backup/home-backup/.ssh ~/ 2>/dev/null || true
  cp -a /mnt/c/caelicode-backup/home-backup/.gitconfig ~/ 2>/dev/null || true
  # ...restore other personal files as needed

Step 5 — When satisfied, clean up (from PowerShell):
  Remove-Item -Recurse -Force C:\\caelicode-backup

EOF
    exit 0
fi

# ── Release lookup ───────────────────────────────────────────────────
strip_v() { printf '%s' "${1#v}"; }

# is_newer A B → true when A is strictly newer than B (semver-ish)
is_newer() {
    local a b
    a="$(strip_v "$1")"; b="$(strip_v "$2")"
    [ "$a" != "$b" ] && [ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -1)" = "$a" ]
}

is_semver() { [[ "$(strip_v "$1")" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; }

fetch_release_json() {
    # Populates RELEASE_JSON. Uses a conditional request (ETag) for the
    # latest-release lookup so the daily scheduled check does not burn
    # unauthenticated API quota.
    local url out code etag
    if [ -n "$TARGET_VERSION" ]; then
        url="${API_BASE}/releases/tags/${TARGET_VERSION}"
        out="${TEMP_DIR}/release.json"
        if ! curl -sfL -o "$out" "$url"; then
            err "Release '${TARGET_VERSION}' not found (${url})"
            return 1
        fi
        RELEASE_JSON_FILE="$out"
        return 0
    fi

    url="${API_BASE}/releases/latest"
    out="${TEMP_DIR}/release.json"
    etag=""
    [ -r "$ETAG_FILE" ] && etag="$(cat "$ETAG_FILE")"
    local -a cond_headers=()
    [ -n "$etag" ] && cond_headers=(-H "If-None-Match: ${etag}")

    code="$(curl -sL -o "$out" -D "${TEMP_DIR}/headers" \
                 ${cond_headers[@]+"${cond_headers[@]}"} \
                 -w '%{http_code}' "$url" || echo "000")"

    case "$code" in
        200)
            RELEASE_JSON_FILE="$out"
            # Cache the response for 304 replies later (best effort).
            if [ -w "$STATE_DIR" ] || { [ -n "$SUDO" ] && sudo -n true 2>/dev/null; } || [ "$(id -u)" -eq 0 ]; then
                grep -i '^etag:' "${TEMP_DIR}/headers" | head -1 | sed 's/^[Ee][Tt][Aa][Gg]:[[:space:]]*//' | tr -d '\r' \
                    | run_priv tee "$ETAG_FILE" >/dev/null 2>&1 || true
                run_priv cp "$out" "$RELEASE_CACHE" 2>/dev/null || true
            fi
            ;;
        304)
            if [ -r "$RELEASE_CACHE" ]; then
                RELEASE_JSON_FILE="$RELEASE_CACHE"
            else
                # Cache lost — retry unconditionally.
                if curl -sfL -o "$out" "$url"; then
                    RELEASE_JSON_FILE="$out"
                else
                    err "Failed to fetch release info from GitHub"
                    return 1
                fi
            fi
            ;;
        *)
            err "Failed to fetch release info from GitHub (HTTP ${code})"
            err "Check your internet connection or try again later"
            return 1
            ;;
    esac
}

# Privileged file write helper that degrades to plain execution as root.
run_priv() {
    if [ -z "$SUDO" ]; then "$@"; else sudo -n "$@"; fi
}

json_field() { jq -r "$1 // empty" "$2" 2>/dev/null; }

asset_url() {
    jq -r --arg name "$1" '.assets[]? | select(.name == $name) | .browser_download_url' \
        "$RELEASE_JSON_FILE" 2>/dev/null | head -1
}

write_state() {
    # write_state <latest> <available> <requires_reimport> <notes_url>
    local dir_ok=false
    if [ -d "$STATE_DIR" ] && { [ -w "$STATE_DIR" ] || [ "$(id -u)" -eq 0 ] || sudo -n true 2>/dev/null; }; then
        dir_ok=true
    fi
    $dir_ok || return 0
    jq -n --arg current "$CURRENT_VERSION" --arg latest "$1" \
          --argjson available "$2" --argjson reimport "$3" \
          --arg notes "$4" --arg checked "$(date -Is)" \
          '{current: $current, latest: $latest, available: $available,
            requires_reimport: $reimport, notes_url: $notes, checked_at: $checked}' \
        | run_priv tee "$STATE_FILE" >/dev/null || true
}

# ── mise helpers ─────────────────────────────────────────────────────
# mise data lives in root-owned /opt/mise: run it privileged, with its
# environment passed explicitly (sudo env_reset would otherwise strip
# MISE_DATA_DIR and silently install into root's home).
run_mise() {
    run_priv env MISE_DATA_DIR=/opt/mise MISE_CONFIG_DIR=/opt/mise/config \
        XDG_DATA_HOME=/opt/mise PATH="/opt/mise/bin:/usr/local/bin:/usr/bin:/bin" \
        mise "$@"
}

# The runtime PATH uses direct symlinks in /opt/mise/bin (mise shims hang
# in WSL). Those symlinks point at version-specific install paths, so they
# MUST be regenerated after tool versions change or updates never take
# effect even though `mise install` succeeded.
regen_tool_symlinks() {
    local shim tool real
    for shim in /opt/mise/shims/*; do
        [ -e "$shim" ] || continue
        tool="$(basename "$shim")"
        real="$(run_mise which "$tool" 2>/dev/null || true)"
        if [ -n "$real" ] && [ -x "$real" ]; then
            run_priv ln -sf "$real" "/opt/mise/bin/${tool}"
        fi
    done
}

# ── Rollback ─────────────────────────────────────────────────────────
if [ "$MODE" = "rollback" ]; then
    require_sudo
    PREV="$(cat "$PREVIOUS_FILE" 2>/dev/null || true)"
    if [ -z "$PREV" ] || [ ! -d "${RELEASES_DIR}/${PREV}" ]; then
        err "No previous release available to roll back to."
        exit 1
    fi
    log "Rolling back: ${CURRENT_VERSION} → ${PREV}"
    run_priv ln -sfn "releases/${PREV}" "$CURRENT_LINK"
    printf '%s\n' "$CURRENT_VERSION" | run_priv tee "$PREVIOUS_FILE" >/dev/null
    printf '%s\n' "$PREV" | run_priv tee "$VERSION_FILE" >/dev/null
    # Re-sync mise tools to the rolled-back profile pins.
    PROFILE_TOML="${RELEASES_DIR}/${PREV}/profiles/${CURRENT_PROFILE}.toml"
    if [ -f "$PROFILE_TOML" ]; then
        run_priv cp "$PROFILE_TOML" "$MISE_CONFIG"
        run_mise install || warn "mise install failed — tool versions may not match ${PREV}"
        run_mise reshim || true
        regen_tool_symlinks
    fi
    log "Rolled back to ${PREV}. Run 'caelicode-update' to move forward again."
    exit 0
fi

# ── Check for Updates ────────────────────────────────────────────────
log "Current version: ${CURRENT_VERSION} (${CURRENT_PROFILE} profile)"

fetch_release_json || exit 1

LATEST_VERSION="$(json_field '.tag_name' "$RELEASE_JSON_FILE")"
NOTES_URL="$(json_field '.html_url' "$RELEASE_JSON_FILE")"
CHANGELOG="$(json_field '.body' "$RELEASE_JSON_FILE")"

if [ -z "$LATEST_VERSION" ]; then
    err "Could not determine latest version"
    exit 1
fi

# Release metadata (manifest is authoritative when present)
REQUIRES_REIMPORT=false
MANIFEST_URL="$(asset_url "$MANIFEST_ASSET")"
PAYLOAD_URL="$(asset_url "$PAYLOAD_ASSET")"
PAYLOAD_SHA256=""
if [ -n "$MANIFEST_URL" ]; then
    if curl -sfL -o "${TEMP_DIR}/manifest.json" "$MANIFEST_URL"; then
        REQUIRES_REIMPORT="$(jq -r '.requires_reimport // false' "${TEMP_DIR}/manifest.json")"
        PAYLOAD_SHA256="$(jq -r '.payload_sha256 // empty' "${TEMP_DIR}/manifest.json")"
    else
        warn "Could not download release manifest — proceeding without it"
    fi
fi

TARGET="${TARGET_VERSION:-$LATEST_VERSION}"

UP_TO_DATE=false
if [ "$CURRENT_VERSION" = "$TARGET" ]; then
    UP_TO_DATE=true
elif [ -z "$TARGET_VERSION" ] && is_semver "$CURRENT_VERSION" && ! is_newer "$TARGET" "$CURRENT_VERSION"; then
    # Latest release is not newer (e.g. a yanked release re-listed) —
    # never silently downgrade unless the user pinned a tag explicitly.
    UP_TO_DATE=true
fi

if [ "$MODE" = "check" ]; then
    if $UP_TO_DATE; then
        write_state "$LATEST_VERSION" false "$REQUIRES_REIMPORT" "$NOTES_URL"
        log "Up to date (${CURRENT_VERSION})"
        exit 0
    fi
    write_state "$LATEST_VERSION" true "$REQUIRES_REIMPORT" "$NOTES_URL"
    if [ "$REQUIRES_REIMPORT" = "true" ]; then
        log "Update available: ${CURRENT_VERSION} → ${LATEST_VERSION} (requires full re-import — run: caelicode-update --full)"
        exit 20
    fi
    log "Update available: ${CURRENT_VERSION} → ${LATEST_VERSION} (run: caelicode-update)"
    exit 10
fi

if $UP_TO_DATE; then
    log "Already at ${CURRENT_VERSION} — nothing to do."
    write_state "$LATEST_VERSION" false "$REQUIRES_REIMPORT" "$NOTES_URL"
    exit 0
fi

if ! is_semver "$CURRENT_VERSION" && [ -z "$TARGET_VERSION" ]; then
    warn "Installed version '${CURRENT_VERSION}' is not a release build;"
    warn "updating in place to ${TARGET}. Locally built images may differ"
    warn "from release images at the apt-package level."
fi

log "Update target: ${CURRENT_VERSION} → ${TARGET}"

if [ -n "$CHANGELOG" ] && ! $QUIET; then
    echo ""
    echo "Changelog:"
    echo "──────────"
    printf '%s\n' "$CHANGELOG" | head -30
    echo ""
fi

if [ "$REQUIRES_REIMPORT" = "true" ] && ! $FORCE; then
    err "Release ${TARGET} includes OS-level changes and requires a full re-import."
    err "Run 'caelicode-update --full' for the guide, or re-run with --force to"
    err "apply the in-place parts anyway (scripts/configs only)."
    exit 20
fi

if [ "$MODE" = "dry-run" ]; then
    log "[DRY RUN] Would stage ${TARGET} into ${RELEASES_DIR}/${TARGET}"
    if [ -n "$PAYLOAD_URL" ]; then
        log "[DRY RUN] Payload: ${PAYLOAD_ASSET} (sha256-verified)"
    else
        log "[DRY RUN] Payload: source archive fallback (NO checksum — legacy release)"
    fi
    log "[DRY RUN] Would then update:"
    log "[DRY RUN]   - /opt/caelicode/current → releases/${TARGET} (atomic flip)"
    log "[DRY RUN]   - /usr/local/bin command symlinks"
    log "[DRY RUN]   - /etc/skel shell templates"
    log "[DRY RUN]   - /etc/caelicode/starship.toml (only if unmodified/theme-tracked)"
    log "[DRY RUN]   - systemd update-check units"
    log "[DRY RUN]   - mise tools per profiles/${CURRENT_PROFILE}.toml + /opt/mise/bin symlinks"
    log "[DRY RUN] Rollback would restore: ${CURRENT_VERSION}"
    exit 0
fi

# ── Download & Verify ────────────────────────────────────────────────
require_sudo

PAYLOAD_ROOT=""
cd "$TEMP_DIR"

if [ -n "$PAYLOAD_URL" ]; then
    log "Downloading update payload..."
    if ! curl -sfL -o payload.tar.gz "$PAYLOAD_URL"; then
        err "Failed to download ${PAYLOAD_ASSET}"
        exit 1
    fi
    if [ -n "$PAYLOAD_SHA256" ]; then
        echo "${PAYLOAD_SHA256}  payload.tar.gz" | sha256sum -c --quiet - || {
            err "Checksum verification FAILED for ${PAYLOAD_ASSET}."
            err "Refusing to apply. Try again, and if this persists report it:"
            err "  https://github.com/${REPO}/issues"
            exit 1
        }
        log "Payload checksum verified"
    else
        warn "Manifest carries no payload checksum — applying unverified payload"
    fi
    mkdir -p payload && tar xzf payload.tar.gz -C payload
    PAYLOAD_ROOT="${TEMP_DIR}/payload"
else
    # Legacy fallback: releases published before the manifest/payload era.
    warn "This release has no update payload asset; falling back to the"
    warn "source archive (no checksum available for source archives)."
    ARCHIVE_URL="https://github.com/${REPO}/archive/refs/tags/${TARGET}.tar.gz"
    if ! curl -sfL -o source.tar.gz "$ARCHIVE_URL"; then
        err "Failed to download source archive: ${ARCHIVE_URL}"
        exit 1
    fi
    tar xzf source.tar.gz
    SRC_DIR="$(find . -maxdepth 1 -type d -name 'wsl-*' -print -quit)"
    if [ -z "$SRC_DIR" ] || [ ! -d "$SRC_DIR" ]; then
        err "Could not find extracted source directory"
        exit 1
    fi
    # Normalize the source tree into the payload layout.
    mkdir -p payload/skel payload/themes payload/systemd
    cp -a "${SRC_DIR}/scripts"  payload/scripts
    cp -a "${SRC_DIR}/profiles" payload/profiles
    [ -d "${SRC_DIR}/config/themes" ] && cp -a "${SRC_DIR}/config/themes/." payload/themes/
    [ -f "${SRC_DIR}/config/starship.toml" ] && cp "${SRC_DIR}/config/starship.toml" payload/themes/default.toml
    for f in .bashrc .bash_aliases .zshrc; do
        [ -f "${SRC_DIR}/config/${f}" ] && cp "${SRC_DIR}/config/${f}" "payload/skel/${f}"
    done
    [ -d "${SRC_DIR}/config/systemd" ] && cp -a "${SRC_DIR}/config/systemd/." payload/systemd/
    PAYLOAD_ROOT="${TEMP_DIR}/payload"
fi

for required in scripts profiles themes; do
    if [ ! -d "${PAYLOAD_ROOT}/${required}" ]; then
        err "Update payload is missing '${required}/' — refusing to apply"
        exit 1
    fi
done

# ── Stage Release ────────────────────────────────────────────────────
log "Staging release ${TARGET}..."
STAGING="${RELEASES_DIR}/.staging-${TARGET}"
run_priv rm -rf "$STAGING" "${RELEASES_DIR}/${TARGET}"
run_priv mkdir -p "$RELEASES_DIR" "$STATE_DIR"
run_priv cp -a "$PAYLOAD_ROOT" "$STAGING"
run_priv find "$STAGING/scripts" -type f -name "*.sh" -exec chmod +x {} +
for tool in caelicode-update caelicode-theme caelicode-config caelicode-runtime-init code; do
    [ -f "${STAGING}/scripts/${tool}" ] && run_priv chmod +x "${STAGING}/scripts/${tool}"
done
run_priv mv "$STAGING" "${RELEASES_DIR}/${TARGET}"

# ── Apply (per-component; the flip below is the atomic activation) ──

# 1. Command symlinks route through /opt/caelicode/current so they stay
#    valid across flips; (re)create them, replacing legacy flat-path links.
log "Refreshing command symlinks..."
link_cmd() { run_priv ln -sf "${CURRENT_LINK}/scripts/$1" "/usr/local/bin/$2"; }
link_cmd caelicode-update  caelicode-update
link_cmd health-check.sh   caelicode-health
link_cmd caelicode-theme   caelicode-theme
link_cmd caelicode-config  caelicode-config
link_cmd code              code

# 2. Shell templates for new users (existing homes are never touched)
if [ -d "${PAYLOAD_ROOT}/skel" ]; then
    log "Updating shell templates in /etc/skel..."
    for f in .bashrc .bash_aliases .zshrc; do
        [ -f "${PAYLOAD_ROOT}/skel/${f}" ] && run_priv cp "${PAYLOAD_ROOT}/skel/${f}" "${SKEL_DIR}/${f}"
    done
fi

# 3. Starship config. Hash the OLD default/themes BEFORE anything is
#    overwritten, so we can tell apart:
#      - stock users (active == old default)        → give them the new default
#      - theme users (active == an old theme file)  → give them the new same theme
#      - customized users                            → never touch
OLD_THEMES_DIR=""
if [ -L "$CURRENT_LINK" ] && [ -d "${CURRENT_LINK}/themes" ]; then
    OLD_THEMES_DIR="$(readlink -f "$CURRENT_LINK")/themes"
elif [ -d "${BASE_DIR}/themes" ]; then
    OLD_THEMES_DIR="${BASE_DIR}/themes"   # legacy flat layout
fi

ACTIVE_CONF="${ETC_DIR}/starship.toml"
NEW_THEMES_DIR="${RELEASES_DIR}/${TARGET}/themes"
if [ -d "$NEW_THEMES_DIR" ]; then
    if [ ! -f "$ACTIVE_CONF" ]; then
        log "Installing default starship config..."
        run_priv cp "${NEW_THEMES_DIR}/default.toml" "$ACTIVE_CONF"
    elif [ -n "$OLD_THEMES_DIR" ] && [ -d "$OLD_THEMES_DIR" ]; then
        ACTIVE_HASH="$(md5sum "$ACTIVE_CONF" | cut -d' ' -f1)"
        MATCHED_THEME=""
        for old_theme in "$OLD_THEMES_DIR"/*.toml; do
            [ -f "$old_theme" ] || continue
            if [ "$(md5sum "$old_theme" | cut -d' ' -f1)" = "$ACTIVE_HASH" ]; then
                MATCHED_THEME="$(basename "$old_theme")"
                break
            fi
        done
        if [ -n "$MATCHED_THEME" ] && [ -f "${NEW_THEMES_DIR}/${MATCHED_THEME}" ]; then
            log "Updating starship config (theme: ${MATCHED_THEME%.toml})..."
            run_priv cp "${NEW_THEMES_DIR}/${MATCHED_THEME}" "$ACTIVE_CONF"
        else
            log "Starship config is customized — leaving it untouched"
        fi
    fi
fi

# 4. systemd units (update-check timer)
if [ -d "${PAYLOAD_ROOT}/systemd" ]; then
    log "Updating systemd units..."
    run_priv cp -a "${PAYLOAD_ROOT}/systemd/." /etc/systemd/system/
    run_priv mkdir -p /etc/systemd/system/timers.target.wants
    run_priv ln -sf /etc/systemd/system/caelicode-update-check.timer \
        /etc/systemd/system/timers.target.wants/caelicode-update-check.timer
    if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
        run_priv systemctl daemon-reload || true
        run_priv systemctl restart caelicode-update-check.timer 2>/dev/null || true
    fi
fi

# 4b. Legacy images: enable systemd for the update-check timer.
if ! grep -q '^\[boot\]' /etc/wsl.conf 2>/dev/null; then
    log "Enabling systemd in /etc/wsl.conf (takes effect after 'wsl --shutdown')..."
    printf '\n[boot]\nsystemd = true\n' | run_priv tee -a /etc/wsl.conf >/dev/null
fi

# 5. Tools: sync the profile pins, install, and regenerate the
#    /opt/mise/bin symlinks that the runtime PATH actually uses.
PROFILE_TOML="${RELEASES_DIR}/${TARGET}/profiles/${CURRENT_PROFILE}.toml"
if [ -f "$PROFILE_TOML" ]; then
    log "Updating tool versions via mise (this can take a few minutes)..."
    run_priv cp "$PROFILE_TOML" "$MISE_CONFIG"
    if run_mise install 2>&1 | tail -20; then
        run_mise reshim || true
        regen_tool_symlinks
        log "  ✓ Tool versions updated"
    else
        warn "mise install failed — scripts/configs are updated, but tool"
        warn "versions were not. Re-run 'caelicode-update' to retry, or"
        warn "'caelicode-update --rollback' to return to ${CURRENT_VERSION}."
    fi
else
    warn "Profile TOML not found: ${PROFILE_TOML} — skipping tool update"
fi

# ── Activate (atomic) ────────────────────────────────────────────────
run_priv ln -sfn "releases/${TARGET}" "$CURRENT_LINK"
printf '%s\n' "$CURRENT_VERSION" | run_priv tee "$PREVIOUS_FILE" >/dev/null
printf '%s\n' "$TARGET" | run_priv tee "$VERSION_FILE" >/dev/null
write_state "$LATEST_VERSION" false "$REQUIRES_REIMPORT" "$NOTES_URL"

# ── Prune (keep current + previous for rollback) ─────────────────────
run_priv rm -rf "${RELEASES_DIR}/.staging-"* 2>/dev/null || true
KEEP_A="$TARGET"
KEEP_B="$(cat "$PREVIOUS_FILE" 2>/dev/null || true)"
for dir in "$RELEASES_DIR"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    if [ "$name" != "$KEEP_A" ] && [ "$name" != "$KEEP_B" ]; then
        run_priv rm -rf "$dir"
    fi
done

echo ""
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
log "Updated: ${CURRENT_VERSION} → ${TARGET}"
log "Rollback available: caelicode-update --rollback"
log "Restart your shell or run: exec \$SHELL"
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

}

# Call main with all arguments — the function wrapper ensures bash reads
# the entire script into memory before executing, so self-update and
# release pruning can never yank the file out from under the interpreter.
main "$@"
